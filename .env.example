# ─────────────────────────────────────────────────────────────────
# Naturegraph : Variables d'environnement
#
# ENVIRONNEMENTS SUPABASE :
#   develop + staging → naturegraph-dev  (projet de développement)
#   main (production) → naturegraph-prod (projet de production)
#
# Copier ce fichier en .env.local et renseigner les valeurs
# correspondant à votre environnement de travail.
# ─────────────────────────────────────────────────────────────────

# Supabase : DEV (pour develop et staging)
# Récupérer dans : supabase.com → naturegraph-dev → Settings → API Keys
#
# IMPORTANT (BATCH 111) : utiliser la clé JWT `anon` legacy
# (format `eyJhbGciOi...`), PAS le nouveau format `sb_publishable_*`.
# Le format publishable rejette silencieusement DELETE/UPDATE/RPC côté
# PostgREST alors que GET passe : symptôme : admin lecture OK / écriture KO
# sans message d'erreur (bouton qui ne fait rien).
VITE_SUPABASE_URL=https://your-dev-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...   # JWT anon legacy, PAS sb_publishable_*

# Supabase : PROD (pour main uniquement : ne jamais utiliser en dev)
# VITE_SUPABASE_URL=https://your-prod-project.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─────────────────────────────────────────────────────────────────
# Beta closed access (BATCH 28-30 / strategy v2.0)
# ─────────────────────────────────────────────────────────────────
# Active le BetaKeyGate sur /signup (necessite cle NG-XXXX-XXXX).
# - false en dev (signup classique sans cle)
# - true en production (Vercel Production env vars)
VITE_BETA_GATE_ENABLED=false

# ─────────────────────────────────────────────────────────────────
# Monitoring production (optionnel)
# ─────────────────────────────────────────────────────────────────
# Sentry : erreurs JS frontend en prod uniquement.
# Pre-requis : npm install @sentry/react (dep dynamique lazy-loaded
# via src/lib/monitoring.ts, ne consomme pas de bundle si vide).
# DSN : copier depuis sentry.io > Projets > naturegraph > Settings > Client Keys.
# VITE_SENTRY_DSN=https://your-dsn@sentry.io/your-project-id

# Discriminer les logs Sentry par environnement.
# Valeurs : development | staging | production
VITE_APP_ENV=development

# ─────────────────────────────────────────────────────────────────
# Secrets Supabase Edge Functions (côté serveur : PAS dans .env.local)
# ─────────────────────────────────────────────────────────────────
# Ces variables NE sont PAS pour le frontend.
# Elles doivent être configurées dans :
#   Supabase Dashboard → Edge Functions → Secrets
#   ou via la CLI : supabase secrets set CLE=valeur
#
# Variables auto-injectées par Supabase (déjà disponibles) :
#   SUPABASE_URL              : URL projet
#   SUPABASE_SERVICE_ROLE_KEY : clé service_role (DEVELOPMENT/PROD selon le projet)
#   SUPABASE_ANON_KEY         : clé anon publique
#
# À configurer manuellement :
#
# 1. weekly-species-digest (cron job hebdo) :
#    CRON_SECRET=<token aléatoire 32+ chars>
#      → header X-Cron-Secret requis pour déclencher le cron.
#
# 2. send-waitlist-confirmation (email confirmation waitlist) :
#    RESEND_API_KEY=re_xxxxxxxxxxxx
#      → clé API Resend (https://resend.com) pour envoi mails.
#    RESEND_FROM="Naturegraph <hello@naturegraph.fr>"
#      → expéditeur des emails (domain doit être vérifié sur Resend).
#
# Si ces secrets ne sont pas configurés :
#   - weekly-species-digest : refusera les appels (403)
#   - send-waitlist-confirmation : entrera en mode dégradé (insertion DB OK, pas d'email)
