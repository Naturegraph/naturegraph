# ─────────────────────────────────────────────────────────────────
# Naturegraph — Variables d'environnement
#
# ENVIRONNEMENTS SUPABASE :
#   develop + staging → naturegraph-dev  (projet de développement)
#   main (production) → naturegraph-prod (projet de production)
#
# Copier ce fichier en .env.local et renseigner les valeurs
# correspondant à votre environnement de travail.
# ─────────────────────────────────────────────────────────────────

# Supabase — DEV (pour develop et staging)
# Récupérer dans : supabase.com → naturegraph-dev → Settings → API
VITE_SUPABASE_URL=https://your-dev-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-dev-anon-key

# Supabase — PROD (pour main uniquement — ne jamais utiliser en dev)
# VITE_SUPABASE_URL=https://your-prod-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-prod-anon-key
