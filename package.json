{
  "name": "naturegraph",
  "private": true,
  "version": "0.8.2",
  "description": "Naturegraph : Explorez, documentez et partagez la biodiversite",
  "author": "Nicolas",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss,css,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "seed:cities": "node scripts/seed-cities.mjs",
    "ci:health": "node scripts/ci-health.mjs",
    "check:types-drift": "node scripts/check-supabase-types-drift.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "check:dead-code": "knip",
    "release:patch": "npm version patch --no-git-tag-version && node scripts/print-version.mjs",
    "release:minor": "npm version minor --no-git-tag-version && node scripts/print-version.mjs",
    "release:major": "npm version major --no-git-tag-version && node scripts/print-version.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,css,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@sentry/react": "^10.57.0",
    "@supabase/supabase-js": "^2.108.1",
    "@tanstack/react-query": "^5.101.0",
    "@vercel/analytics": "^2.0.1",
    "exifr": "^7.1.3",
    "heic2any": "^0.0.4",
    "i18next": "^25.10.10",
    "lucide-react": "^0.577.0",
    "motion": "^12.38.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.8",
    "react-router-dom": "^7.18.2",
    "sass": "^1.98.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.10.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.32.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "esbuild": "^0.28.1",
    "js-yaml": "^4.3.0",
    "brace-expansion@1": "1.1.16",
    "@vercel/node": {
      "undici": "^6.27.0",
      "path-to-regexp": "^6.3.0",
      "ajv": "^8.18.0"
    },
    "@vercel/python-analysis": {
      "minimatch": "^10.2.3",
      "smol-toml": "^1.6.1"
    },
    "jsdom": {
      "undici": "^7.28.0"
    }
  }
}
